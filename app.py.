import os
import hmac
import hashlib
import logging
from flask import Flask, request, jsonify

app = Flask(__name__)
logging.basicConfig(level=logging.INFO)

VERIFY_TOKEN = os.environ.get('META_VERIFY_TOKEN', '')
APP_SECRET = os.environ.get('META_APP_SECRET', '')
TELEGRAM_URL = 'https://t.me/KodexAIMGroupBot'

@app.get('/')
def home():
    return jsonify({
        'service': 'KODEX Social AI',
        'status': 'running',
        'telegram': TELEGRAM_URL
    })

@app.get('/webhook')
def verify_webhook():
    mode = request.args.get('hub.mode', '')
    token = request.args.get('hub.verify_token', '')
    challenge = request.args.get('hub.challenge', '')
    if mode == 'subscribe' and VERIFY_TOKEN and hmac.compare_digest(token, VERIFY_TOKEN):
        return challenge, 200
    return 'Webhook verification failed', 403

@app.post('/webhook')
def receive_webhook():
    raw_body = request.get_data()
    signature = request.headers.get('X-Hub-Signature-256', '')
    if APP_SECRET:
        expected = 'sha256=' + hmac.new(APP_SECRET.encode(), raw_body, hashlib.sha256).hexdigest()
        if not hmac.compare_digest(signature, expected):
            return jsonify({'error': 'Invalid signature'}), 401
    payload = request.get_json(silent=True) or {}
    logging.info('Meta webhook event received: object=%s', payload.get('object', 'unknown'))
    return jsonify({'status': 'received'}), 200

@app.get('/health')
def health():
    return jsonify({'status': 'ok'}), 200
